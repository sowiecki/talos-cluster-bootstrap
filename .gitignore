# Local .terraform directory (but NOT the lock file)
.terraform/

# Terraform state files (sensitive)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log
tofu.log

# Exclude all .tfvars files, which may contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files (local overrides, not committed)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore tfplan files (binary plan output)
*tfplan*
!plan.out  # if you want to keep a sample plan file

# Helm
# Local Helm cache/repository (if you run helm repo add locally)
.helm/
# If you download charts into a charts/ directory, ignore them
charts/  # only if you use `helm dependency build` and commit the lock file but not the tgz

# Talos / Kubernetes generated configs
kubeconfig
talosconfig

# OS files
.DS_Store
*.swp
*.swo
*~
*.bak
*.tmp

# IDE directories
.vscode/
.idea/
*.sublime-*
*.vscode/

# Secrets / environment files (if you store secrets here)
.env
*.env
*.secrets.*
*.secret.*

# Optional: ignore any sensitive SSH keys or tokens (if you happen to place them here)
*.pem
*.key
*.crt
